# Cổng BE (FE dev chạy 3000 → BE 4100 tránh trùng).
PORT=4100

# CORS allowlist origin của FE (bắt buộc, FE static gọi cross-origin).
WEB_ORIGIN=http://localhost:3000

# Nguồn crawl: mock (phase dev, metric giả) | real (adapter thật — hiện có Facebook).
CRAWLER_MODE=mock

# Proxy cho crawl FB (FB gate nội dung theo IP). Chọn 1 trong 2:
#   KIOTPROXY_KEY: lấy proxy động qua API KiotProxy (ưu tiên nếu có).
#   FB_PROXY_URL : proxy tĩnh http://user:pass@host:port (fallback).
# KIOTPROXY_KEY=
# FB_PROXY_URL=

# Override doc_id/endpoint GraphQL FB (chỉ set khi FB đổi; mặc định đã hoạt động).
# FB_GRAPHQL_URL=https://www.facebook.com/api/graphql/
# FB_DOC_ID_RESOLVE=36104137065899111
# FB_DOC_ID_POST=8180153265427288
# FB_DOC_ID_VIDEO=26984026684624315
